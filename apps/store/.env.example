# Do'konchi paneli (apps/store) — muhit o'zgaruvchilari namunasi.
# Haqiqiy qiymatlar uchun .env.local yarating (u git'ga tushmaydi).
# Barcha NEXT_PUBLIC_* qiymatlari BUILD vaqtida yopishadi — Railway'da ham build oldidan sozlang.

# Backend API manzili (oxirida /api/v1 bilan)
NEXT_PUBLIC_API_URL=https://api.ryadom.uz/api/v1

# Yandex Maps JS API kaliti (https://developer.tech.yandex.ru — bepul tarif: 1000 so'rov/kun)
# Xavfsizlik: kalitni Yandex kabinetida ryadom.uz domenlariga cheklab qo'ying.
NEXT_PUBLIC_YANDEX_MAPS_KEY=your-yandex-maps-api-key-here
