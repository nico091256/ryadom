{
  "expo": {
    "name": "LocalShop",
    "slug": "localshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "localshop",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.localshop.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Do'konlarni masofaga ko'ra topish va yetkazib berish manzilini belgilash uchun joylashuvingiz kerak bo'ladi.",
        "NSCameraUsageDescription": "Mahsulotlar va do'kon rasmini yuklash uchun kameraga ruxsat bering.",
        "NSPhotoLibraryUsageDescription": "Mahsulotlar rasmini galereyadan tanlash uchun ruxsat bering."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "package": "uz.localshop.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Do'konlarni masofaga ko'ra topish uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mahsulotlar rasmini tanlash uchun ruxsat bering."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "localshop-tashkent"
      }
    }
  }
}
