# ==========================================
# Local Shop Delivery Platform Environment Variables
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
PLATFORM_NAME=LocalShop
FRONTEND_URL=http://localhost:3000

# Allowed browser origins (comma-separated). REQUIRED in production (the API refuses to start without it);
# in development it may be left empty - the request origin is then reflected.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Set to true ONLY when the API runs behind a reverse proxy / load balancer (nginx, Traefik, Cloud LB) so the
# rate limiter keys on the real client IP from X-Forwarded-For. On a directly exposed server keep false.
TRUST_PROXY=false

# Swagger UI at /docs is always on outside production; set ENABLE_SWAGGER=true to expose it in production too.
ENABLE_SWAGGER=

# Load-test switch: true turns every rate limiter off (k6 from a single IP). Refused when NODE_ENV=production.
THROTTLE_DISABLED=false

# Database (PostgreSQL + PostGIS)
# docker-compose REQUIRES POSTGRES_PASSWORD (no default; `docker compose up` refuses to start without it).
# Generate one with:  openssl rand -hex 24   and use the same value inside DATABASE_URL.
# Postgres is published on 127.0.0.1:5432 only (reachable from this host, not from the network).
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/localshop?schema=public"

# Redis (BullMQ auto-cancel queue, idempotency keys, Socket.IO adapter)
# docker-compose REQUIRES REDIS_PASSWORD: the container starts with --requirepass and the API connects with it.
# Generate one with:  openssl rand -hex 24.  Redis is published on 127.0.0.1:6379 only.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT access tokens; refresh tokens are opaque, DB-persisted and rotated (see RefreshToken model)
# JWT_ACCESS_SECRET is REQUIRED and must be >= 32 random characters. Generate one with:  openssl rand -hex 32
# The API refuses to start in production with a short secret or with the old development default.
# (Outside production a missing value falls back to an insecure dev default and logs a warning.)
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRATION="15m"
# Lifetime of the refresh token (also the Max-Age of the httpOnly `ryadom_rt` cookie used by the web panels)
REFRESH_TOKEN_TTL_DAYS=30

# Yandex Maps & Geocoding
YANDEX_MAPS_API_KEY="your-yandex-maps-api-key"
YANDEX_GEOCODER_API_KEY="your-yandex-geocoder-api-key"

# SMS Service (Eskiz.uz provider)
# SMS_PROVIDER options: 'mock' (logs code to console, FIXED code 123456 - dev only) or 'eskiz'.
# The API refuses to start with NODE_ENV=production unless SMS_PROVIDER=eskiz.
SMS_PROVIDER=mock
ESKIZ_EMAIL="info@example.com"
ESKIZ_PASSWORD="secretpassword"

# Push Notifications (Firebase Cloud Messaging)
# Provide either the raw/base64-encoded service account JSON or a path to the file.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Feature Flags
ONLINE_PAYMENTS_ENABLED=false

# Payment Gateway Credentials (Phase 2)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# File Upload / S3 Compatible Storage
UPLOAD_DRIVER=local
UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET="localshop-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Observability (optional)
# Protects GET /api/v1/metrics (Prometheus) and GET /api/v1/health/details (services/memory/uptime).
# Callers send `Authorization: Bearer <METRICS_TOKEN>`. Empty = open (fine behind a private network).
# GET /api/v1/health itself stays public and returns only { status, timestamp }.
METRICS_TOKEN=""
# Sentry is a no-op until a DSN is set.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""

# Region & Defaults
DEFAULT_CITY="Tashkent"
DEFAULT_LANGUAGE="uz"
DEFAULT_SEARCH_RADIUS_METERS=3000
ORDER_ACCEPTANCE_TIMEOUT_MINUTES=10
