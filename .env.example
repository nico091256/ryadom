# ==========================================
# Local Shop Delivery Platform Environment Variables
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
PLATFORM_NAME=LocalShop
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
# For local Docker: postgresql://postgres:postgres@localhost:5432/localshop?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localshop?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (short-lived access tokens, refresh tokens)
JWT_ACCESS_SECRET="super-secret-jwt-access-key-minimum-32-chars-long"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-minimum-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# Yandex Maps & Geocoding
YANDEX_MAPS_API_KEY="your-yandex-maps-api-key"
YANDEX_GEOCODER_API_KEY="your-yandex-geocoder-api-key"

# SMS Service (Eskiz.uz provider)
# SMS_PROVIDER options: 'mock' (logs code to console, default code 123456) or 'eskiz'
SMS_PROVIDER=mock
ESKIZ_EMAIL="info@example.com"
ESKIZ_PASSWORD="secretpassword"

# Push Notifications (Expo Push Notification Service)
EXPO_ACCESS_TOKEN=""

# Feature Flags
ONLINE_PAYMENTS_ENABLED=false

# Payment Gateway Credentials (Phase 2)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# File Upload / S3 Compatible Storage
UPLOAD_DRIVER=local
UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET="localshop-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Region & Defaults
DEFAULT_CITY="Tashkent"
DEFAULT_LANGUAGE="uz"
DEFAULT_SEARCH_RADIUS_METERS=3000
ORDER_ACCEPTANCE_TIMEOUT_MINUTES=5
